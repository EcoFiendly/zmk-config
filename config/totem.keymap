#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2

&mt {
    quick-tap-ms = <175>;
    flavor = "balanced";
    tapping-term-ms = <210>;
};

&lt {
    tapping-term-ms = <210>;
    flavor = "balanced";
    quick-tap-ms = <175>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
        };

        qexcl: qexcl {
            compatible = "zmk,behavior-mod-morph";
            label = "QEXCL";
            bindings = <&kp QUESTION>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        semcom: semcom {
            compatible = "zmk,behavior-mod-morph";
            label = "SEMCOM";
            bindings = <&kp COMMA>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        coldot: coldot {
            compatible = "zmk,behavior-mod-morph";
            label = "COLDOT";
            bindings = <&kp PERIOD>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        spc_3: spc_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "SPC_3";
            #binding-cells = <0>;
            bindings = <&lt 3 SPACE>, <&kp SPACE>, <&tog 3>;
        };

        tab_2: tab_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAB_2";
            #binding-cells = <0>;
            bindings = <&lt 2 TAB>, <&kp TAB>, <&tog 2>;
        };

        ent_1: ent_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "ENT_1";
            #binding-cells = <0>;
            bindings = <&lt 1 RET>, <&none>, <&tog 1>;
        };

        bspc_4: bspc_4 {
            compatible = "zmk,behavior-tap-dance";
            label = "BSPC_4";
            #binding-cells = <0>;
            bindings = <&lt 4 BACKSPACE>, <&kp BACKSPACE>, <&tog 4>;
        };

        del_5: del_5 {
            compatible = "zmk,behavior-tap-dance";
            label = "DEL_5";
            #binding-cells = <0>;
            bindings = <&lt 5 DELETE>, <&kp DELETE>, <&tog 5>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-tap-dance";
            label = "NEW_BEHAVIOR";
            #binding-cells = <0>;
            bindings = <&lt 1 RET>, <&kp ENTER>, <&tog 1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lcurl {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <1 2>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        lsqr {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <11 12>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        lbrac {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <22 23>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        rcurl {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <2 3>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        rsqr {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <12 13>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        rbrac {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <23 24>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        capsw {
            bindings = <&caps_word>;
            key-positions = <10 19>;
            layers = <0>;
        };

        Minus {
            bindings = <&kp KP_MINUS>;
            key-positions = <7 17>;
            layers = <0>;
        };

        Underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <17 28>;
            layers = <0>;
        };

        Plus {
            bindings = <&kp KP_PLUS>;
            key-positions = <8 18>;
            layers = <0>;
        };

        Equal {
            bindings = <&kp KP_EQUAL>;
            key-positions = <18 29>;
            layers = <0>;
        };

        Asterisk {
            bindings = <&kp KP_ASTERISK>;
            key-positions = <9 19>;
            layers = <0>;
        };

        And {
            bindings = <&kp AMPERSAND>;
            key-positions = <19 30>;
            layers = <0>;
        };

        Divide {
            bindings = <&kp KP_SLASH>;
            key-positions = <6 16>;
            layers = <0>;
        };

        Or {
            bindings = <&kp PIPE>;
            key-positions = <16 27>;
            layers = <0>;
        };

        Hat {
            bindings = <&kp CARET>;
            key-positions = <5 15>;
            layers = <0>;
        };

        Percent {
            bindings = <&kp PERCENT>;
            key-positions = <15 26>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
           &kp Q         &kp W        &kp F       &kp P       &kp B     &kp J   &kp L       &kp U       &kp Y        &kp BSLH
           &hm LSHIFT A  &hm LCTRL R  &hm LALT S  &hm LGUI T  &kp G     &kp M   &hm RGUI N  &hm RALT E  &hm RCTRL I  &hm RSHIFT O
&kp GRAVE  &kp Z         &kp X        &kp C       &kp D       &kp V     &kp K   &kp H       &semcom     &coldot      &qexcl        &kp APOSTROPHE
                                      &kp ESCAPE  &spc_3      &tab_2    &ent_1  &bspc_4     &del_5
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
       &kp KP_PLUS   &kp N7  &kp N8  &kp N9   &kp KP_MULTIPLY    &none   &none     &none     &none      &none
       &none         &kp N4  &kp N5  &kp N6   &kp KP_EQUAL       &none   &kp RGUI  &kp RALT  &kp RCTRL  &kp RSHIFT
&none  &kp KP_MINUS  &kp N1  &kp N2  &kp N3   &kp KP_DIVIDE      &none   &none     &none     &none      &none       &none
                             &kp N0  &kp DOT  &kp SPACE          &trans  &none     &none
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
       &none      &none      &none     &none     &none     &none  &none     &kp PAGE_DOWN  &kp PAGE_UP  &none
       &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none     &none  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT
&none  &none      &none      &none     &none     &none     &none  &none     &kp END        &kp HOME     &none      &none
                             &none     &none     &trans    &none  &none     &none
            >;
        };

        UTIL {
            display-name = "Util";
            bindings = <
       &none      &none      &none     &none     &none    &none  &none          &none         &none         &none
       &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none    &none  &kp C_AC_BACK  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_AC_FORWARD
&none  &none      &none      &none     &none     &none    &none  &kp C_PREV     &kp C_MUTE    &kp C_PP      &kp C_NEXT        &none
                             &none     &trans    &none    &none  &none          &none
            >;
        };

        FUN {
            display-name = "Fun";
            bindings = <
       &kp F12  &kp F7  &kp F8  &kp F9  &none    &none  &none     &none     &none      &none
       &kp F11  &kp F4  &kp F5  &kp F6  &none    &none  &kp RGUI  &kp RALT  &kp RCTRL  &kp RSHFT
&none  &kp F10  &kp F1  &kp F2  &kp F3  &none    &none  &none     &none     &none      &none      &none
                        &none   &none   &none    &none  &trans    &none
            >;
        };

        GAME {
            display-name = "Game";
            bindings = <
           &kp Q  &kp W  &kp E    &kp R      &kp T        &none  &none     &none     &none      &none
           &kp A  &kp S  &kp D    &kp F      &kp G        &none  &kp RGUI  &kp RALT  &kp RCTRL  &kp RSHFT
&kp LSHFT  &kp Z  &kp X  &kp C    &kp V      &kp B        &none  &none     &none     &none      &none      &none
                         &kp ESC  &kp SPACE  &kp ENTER    &none  &none     &trans
            >;
        };
    };
};

