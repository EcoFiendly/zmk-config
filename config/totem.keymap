#include "../zmk-helpers/key-labels/totem.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4 LB5 // Left-hand keys.
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4 RB5 // Right-hand keys.
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                         // Thumb keys.

&mt {
    quick-tap-ms = <150>;
    flavor = "balanced";
    tapping-term-ms = <175>;
};

&lt {
    tapping-term-ms = <250>;
    flavor = "balanced";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <140>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <115>;
            tapping-term-ms = <205>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS >; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <115>;
            tapping-term-ms = <205>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = < KEYS_L THUMBS >; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };

        qexcl: qexcl {
            compatible = "zmk,behavior-mod-morph";
            label = "QEXCL";
            bindings = <&kp QUESTION>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        semcom: semcom {
            compatible = "zmk,behavior-mod-morph";
            label = "SEMCOM";
            bindings = <&kp COMMA>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        coldot: coldot {
            compatible = "zmk,behavior-mod-morph";
            label = "COLDOT";
            bindings = <&kp PERIOD>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        spc_3: spc_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "SPC_3";
            #binding-cells = <0>;
            bindings = <&lt 3 SPACE>, <&kp SPACE>, <&none>, <&tog 3>;
        };

        tab_2: tab_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAB_2";
            #binding-cells = <0>;
            bindings = <&lt 2 TAB>, <&kp TAB>, <&none>, <&tog 2>;
        };

        ent_1: ent_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "ENT_1";
            #binding-cells = <0>;
            bindings = <&lt 1 RET>, <&kp ENTER>, <&none>, <&tog 1>;
        };

        bspc_4: bspc_4 {
            compatible = "zmk,behavior-tap-dance";
            label = "BSPC_4";
            #binding-cells = <0>;
            bindings = <&lt 4 BACKSPACE>, <&kp BACKSPACE>, <&none>, <&tog 4>;
        };

        del_5: del_5 {
            compatible = "zmk,behavior-tap-dance";
            label = "DEL_5";
            #binding-cells = <0>;
            bindings = <&lt 5 DELETE>, <&kp DELETE>, <&none>, <&tog 5>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lcurl {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <1 2>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        lsqr {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <11 12>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        lbrac {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <22 23>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        rcurl {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <2 3>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        rsqr {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <12 13>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        rbrac {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <23 24>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        capsw {
            bindings = <&caps_word>;
            key-positions = <10 19>;
            layers = <0>;
        };

        Minus {
            bindings = <&kp MINUS>;
            key-positions = <17 7>;
            layers = <0>;
        };

        Equals {
            bindings = <&kp EQUAL>;
            key-positions = <8 18>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
       &kp Q          &kp W         &kp F        &kp P        &kp B     &kp J   &kp L        &kp U        &kp Y         &kp BSLH
       &hml LSHIFT A  &hml LCTRL R  &hml LALT S  &hml LGUI T  &kp G     &kp M   &hmr RGUI N  &hmr RALT E  &hmr RCTRL I  &hmr RSHIFT O
&none  &kp Z          &kp X         &kp C        &kp D        &kp V     &kp K   &kp H        &semcom      &coldot       &qexcl         &kp APOSTROPHE
                                    &gresc       &spc_3       &tab_2    &ent_1  &bspc_4      &del_5
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
       &kp KP_PLUS   &kp N7  &kp N8  &kp N9   &kp KP_MULTIPLY    &none   &none     &none     &none      &none
       &none         &kp N4  &kp N5  &kp N6   &kp KP_EQUAL       &none   &kp RGUI  &kp RALT  &kp RCTRL  &kp RSHIFT
&none  &kp KP_MINUS  &kp N1  &kp N2  &kp N3   &kp KP_DIVIDE      &none   &none     &none     &none      &none       &none
                             &kp N0  &kp DOT  &kp SPACE          &trans  &none     &none
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
       &none      &none      &none     &none     &none     &none  &none     &kp PAGE_DOWN  &kp PAGE_UP  &none
       &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none     &none  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT
&none  &none      &none      &none     &none     &none     &none  &none     &kp END        &kp HOME     &none      &none
                             &none     &none     &trans    &none  &none     &none
            >;
        };

        UTIL {
            display-name = "Util";
            bindings = <
       &none      &none      &none     &none     &none    &none  &none          &none         &none         &none
       &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none    &none  &kp C_AC_BACK  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_AC_FORWARD
&none  &none      &none      &none     &none     &none    &none  &kp C_PREV     &kp C_MUTE    &kp C_PP      &kp C_NEXT        &none
                             &none     &trans    &none    &none  &none          &none
            >;
        };

        FUN {
            display-name = "Fun";
            bindings = <
       &kp F12  &kp F7  &kp F8  &kp F9  &none    &none  &none     &none     &none      &none
       &kp F11  &kp F4  &kp F5  &kp F6  &none    &none  &kp RGUI  &kp RALT  &kp RCTRL  &kp RSHFT
&none  &kp F10  &kp F1  &kp F2  &kp F3  &none    &none  &none     &none     &none      &none      &none
                        &none   &none   &none    &none  &trans    &none
            >;
        };

        GAME {
            display-name = "Game";
            bindings = <
           &kp Q  &kp W  &kp E    &kp R      &kp T        &none  &none     &none     &none      &none
           &kp A  &kp S  &kp D    &kp F      &kp G        &none  &kp RGUI  &kp RALT  &kp RCTRL  &kp RSHFT
&kp LSHFT  &kp Z  &kp X  &kp C    &kp V      &kp B        &none  &none     &none     &none      &none      &none
                         &kp ESC  &kp SPACE  &kp ENTER    &none  &none     &trans
            >;
        };
    };
};
